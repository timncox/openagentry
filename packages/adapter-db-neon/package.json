{
  "name": "@openagentry/adapter-db-neon",
  "version": "0.1.0-alpha.0",
  "description": "OpenAgentry DatabaseAdapter implementation backed by Neon Postgres",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LLM.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openagentry/core": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@openagentry/adapter-test-suite": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "openagentry": {
    "type": "adapter",
    "category": "db",
    "id": "neon",
    "protocolVersion": "1",
    "envVars": [
      { "name": "NEON_API_KEY", "secret": true, "required": true }
    ],
    "fillsSlots": ["db"],
    "requiresSlots": [],
    "capabilities": {
      "engine": "postgres",
      "envBranches": true,
      "snapshot": "marker"
    },
    "aiFriendly": {
      "structuredErrors": true,
      "dryRun": false,
      "idempotent": ["createInstance", "importState"],
      "queryableState": true
    },
    "llmDocs": "./LLM.md"
  },
  "publishConfig": {
    "access": "public"
  }
}
