{
  "name": "@openagentry/adapter-llm-cli",
  "version": "0.1.0-alpha.0",
  "description": "OpenAgentry LlmAdapter implementation that shells out to local claude / codex / gemini CLIs (operator flavor)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LLM.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openagentry/core": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@openagentry/adapter-test-suite": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "openagentry": {
    "type": "adapter",
    "category": "llm",
    "id": "llm-cli",
    "protocolVersion": "1",
    "envVars": [
      { "name": "OA_LLM_CLI", "secret": false, "required": false },
      { "name": "OA_LLM_CLI_BIN", "secret": false, "required": false }
    ],
    "fillsSlots": ["llm"],
    "requiresSlots": [],
    "capabilities": {
      "supportedClis": "claude,codex,gemini",
      "streaming": true,
      "operatorOnly": true
    },
    "aiFriendly": {
      "structuredErrors": true,
      "dryRun": false,
      "idempotent": [],
      "queryableState": true
    },
    "llmDocs": "./LLM.md"
  },
  "publishConfig": {
    "access": "public"
  }
}
