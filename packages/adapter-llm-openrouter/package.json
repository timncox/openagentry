{
  "name": "@openagentry/adapter-llm-openrouter",
  "version": "0.1.0-alpha.0",
  "description": "OpenAgentry LlmAdapter for OpenRouter (plain fetch against OpenAI-compatible REST API)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "files": ["dist", "LLM.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "openagentry": {
    "type": "adapter",
    "category": "llm",
    "id": "llm-openrouter",
    "protocolVersion": "1",
    "envVars": [
      { "name": "OA_OPENROUTER_API_KEY", "secret": true, "required": true },
      { "name": "OA_OPENROUTER_DEFAULT_MODEL", "secret": false, "required": false },
      { "name": "OA_OPENROUTER_BASE_URL", "secret": false, "required": false },
      { "name": "OA_OPENROUTER_APP_URL", "secret": false, "required": false },
      { "name": "OA_OPENROUTER_APP_TITLE", "secret": false, "required": false }
    ],
    "fillsSlots": ["llm"],
    "requiresSlots": [],
    "capabilities": {
      "streaming": true, "tools": false, "vision": false, "embeddings": false,
      "operatorOnly": false, "runtime": true
    },
    "aiFriendly": {
      "structuredErrors": true, "dryRun": false, "idempotent": [], "queryableState": true
    },
    "llmDocs": "./LLM.md"
  },
  "dependencies": {
    "@openagentry/core": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@openagentry/adapter-test-suite": "workspace:*",
    "@types/node": "^20.0.0",
    "msw": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
