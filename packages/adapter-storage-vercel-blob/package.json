{
  "name": "@openagentry/adapter-storage-vercel-blob",
  "version": "0.1.0-alpha.0",
  "description": "OpenAgentry StorageAdapter implementation for Vercel Blob (via @vercel/blob SDK)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "LLM.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "openagentry": {
    "type": "adapter",
    "category": "storage",
    "id": "storage-vercel-blob",
    "protocolVersion": "1",
    "envVars": [
      { "name": "OA_VERCEL_BLOB_TOKEN", "secret": true, "required": true },
      { "name": "OA_VERCEL_BLOB_DEFAULT_ACCESS", "secret": false, "required": false },
      { "name": "OA_VERCEL_BLOB_CACHE_MAX_AGE_PUBLIC", "secret": false, "required": false },
      { "name": "OA_VERCEL_BLOB_CACHE_MAX_AGE_PRIVATE", "secret": false, "required": false }
    ],
    "fillsSlots": ["storage"],
    "requiresSlots": [],
    "capabilities": {
      "presignedUrls": false,
      "publicUrls": true,
      "multipart": false,
      "streamingUploads": false,
      "rangeReads": false,
      "maxObjectSize": "5TB",
      "accessModel": "per-blob"
    },
    "aiFriendly": {
      "structuredErrors": true,
      "dryRun": false,
      "idempotent": ["delete"],
      "queryableState": true
    },
    "llmDocs": "./LLM.md"
  },
  "dependencies": {
    "@openagentry/core": "workspace:*",
    "@vercel/blob": "^2.3.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@openagentry/adapter-test-suite": "workspace:*",
    "@types/node": "^20.0.0",
    "msw": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
